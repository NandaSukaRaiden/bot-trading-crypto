# ================================================================
#  AI CRYPTO FUTURES BOT — Salin file ini ke .env lalu isi
# ================================================================

# ── AI Keys ──────────────────────────────────────────────────
# GEMINI (WAJIB — AI utama pengambil keputusan)
# Dapatkan di: https://aistudio.google.com/app/apikey (GRATIS)
# 💡 TAMBAH RATE LIMIT: isi beberapa key GRATIS dipisah koma →
#    GOOGLE_API_KEY=key1,key2,key3 (bot auto-rotasi saat kena limit 429)
GOOGLE_API_KEY=AIzaSy_YOUR_GEMINI_KEY_HERE

# GPT-4o (opsional — ensemble untuk akurasi lebih tinggi)
# Dapatkan di: https://platform.openai.com/api-keys
# Juga mendukung multi-key: OPENAI_API_KEY=key1,key2
OPENAI_API_KEY=

# Claude 3.5 Sonnet (opsional — ensemble)
# Dapatkan di: https://console.anthropic.com/
# Juga mendukung multi-key: ANTHROPIC_API_KEY=key1,key2
ANTHROPIC_API_KEY=

# Kenari.id — 49 model (Claude, GPT, Gemini, DeepSeek) via 1 key
# Dapatkan di: https://kenari.id
# Juga mendukung multi-key: KENARI_API_KEY=key1,key2
KENARI_API_KEY=
KENARI_MODEL=laguna-s-2-1:free

# ── AI Provider Utama (opsional — override otomatis) ──────────
#   auto     = pakai SEMUA key yang terisi (ensembel, direkomendasikan)
#   gemini   = hanya Gemini    | openai = hanya GPT
#   anthropic= hanya Claude    | kenari = hanya Kenari
#   custom   = API manapun yang OpenAI-compatible (DeepSeek, Groq, dll)
AI_PROVIDER=auto

# AI UTAMA — dipanggil LEBIH DULU, keputusannya FINAL. Jika gagal →
# fallback ke AI lain. Kosongkan untuk ensembel paralel biasa.
AI_PRIMARY_PROVIDER=kenari
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.05

# custom provider: isi key + endpoint + nama model
# Mendukung multi-key: AI_API_KEY=key1,key2 (rotasi otomatis)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=

# ── Kontrol Keputusan AI ─────────────────────────────────────
# true  = AI menganalisis SEMUA pair tanpa pre-filter teknikal
# false = hanya pair yang lolos filter teknikal yang dikirim ke AI
AI_ANALYZE_ALL_PAIRS=true

# true  = AI juga mengelola posisi terbuka (close/partial/trail/TP)
AI_MANAGE_POSITIONS=true

# Posisi dikelola AI hanya jika sudah bergerak melebihi % ini (hemat API)
AI_MANAGE_MIN_MOVE_PCT=0.35

# ── Binance Exchange ──────────────────────────────────────────
# Tanpa key = paper trading mode (data publik tetap jalan)
# Untuk live trading: buat API key di Binance → Futures aktifkan
EXCHANGE_NAME=binanceusdm
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Gunakan testnet Binance untuk test live sebelum real money
USE_TESTNET=false

# ── Trading Mode ──────────────────────────────────────────────
# paper = simulasi (AMAN, default)
# live  = eksekusi order nyata ke Binance (HATI-HATI)
TRADING_MODE=paper

# ── Trading Style ─────────────────────────────────────────────
# scalper = timeframe 1m/5m/15m, leverage 20x+, holding menit-jam
# swing   = timeframe 1h/4h/1d, leverage rendah, holding 1-7 hari
TRADING_STYLE=scalper

# ── Modal & Risiko ────────────────────────────────────────────
INITIAL_CAPITAL_USDT=1000

# Leverage default (bisa dioverride per simbol di config.py)
DEFAULT_LEVERAGE=10
MAX_LEVERAGE=20

# Risiko per trade dalam % equity (JANGAN lebih dari 2%)
MAX_RISK_PER_TRADE=0.5

# Maksimum posisi aktif bersamaan
MAX_POSITIONS=5

# Skor minimum AI untuk masuk trade (0-100)
MIN_AI_SCORE_TO_TRADE=65

# Batas rugi maksimum sebelum bot berhenti trading hari/minggu itu
DAILY_LOSS_LIMIT_PCT=2.0
WEEKLY_LOSS_LIMIT_PCT=5.0
MAX_DRAWDOWN_PCT=10.0

# ── Interval & Timeframe ──────────────────────────────────────
# Scalper: siklus analisis cepat, timeframe pendek
ANALYSIS_INTERVAL_MINUTES=2
PRIMARY_TIMEFRAME=5m
TREND_TIMEFRAME=1h
CONTEXT_TIMEFRAME=4h

# ── News Data (semua gratis, tanpa login) ─────────────────────
# CryptoPanic free tier (opsional — tambah kualitas berita)
# Daftar di: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# CoinGecko Pro (opsional — lebih banyak data fundamental)
# Dapatkan di: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# Jumlah artikel berita per coin
NEWS_MAX_ITEMS=15

# Cache berita (menit)
NEWS_TTL_MIN=10

# Kirim berita ke AI? (true/false)
INCLUDE_NEWS_IN_AI=true

# ── Chart Viewer ──────────────────────────────────────────────
# Port untuk HTTP server chart gallery di browser
CHART_SERVER_PORT=8008

# ── Telegram Notifikasi (opsional) ───────────────────────────
# Buat bot di @BotFather di Telegram, dapatkan token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
